{% from 'toml-value.j2' import value %}
# {{ ansible_managed }}
{% set managed = {
  'serve': {'port': service_ports.cms},
  'database': {'url': 'postgresql://cms@cms-postgres:' ~ service_ports.postgres ~ '/cms'},
  'telemetry': {
    'enabled': true,
    'traces': {'enabled': true, 'endpoint': 'http://tempo:' ~ service_ports.tempo_otlp ~ '/v1/traces'},
    'metrics': {'enabled': true, 'endpoint': 'http://prometheus:' ~ service_ports.prometheus ~ '/api/v1/otlp/v1/metrics'},
    'logs': {'enabled': true, 'endpoint': 'http://loki:' ~ service_ports.loki ~ '/otlp/v1/logs'}
  }
} %}
{% for key, item in (cms_effective_config | combine(managed, recursive=true)).items() %}
{{ key | to_json(ensure_ascii=false) }} = {{ value(item) }}
{% endfor %}
